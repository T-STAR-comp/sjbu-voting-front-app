# Set this to the deployed voting API server's origin.
# The frontend appends /api/v1 automatically.
VITE_API_URL=https://your-voting-api.example.com

# For local development, leave VITE_API_URL unset to use the Vite proxy,
# or set VITE_API_PROXY_TARGET in the Vite environment to the local API origin.
# For a separate frontend/API deployment, set WEB_ORIGIN on the backend to this
# frontend's exact HTTPS origin so browser requests are allowed by CORS.
